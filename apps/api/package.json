{
  "name": "@drop-win/api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/node.ts",
    "start": "node --env-file-if-exists=../../.env src/node.ts",
    "dev:worker": "wrangler dev --port 5302 --var APP_ENV:development",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@drop-win/contract": "1.0.0",
    "@drop-win/fairness": "1.0.0",
    "@drop-win/ledger": "1.0.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "wrangler": "4.152.0"
  }
}
