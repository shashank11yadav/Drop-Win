# Copy to .env for local development: cp .env.example .env
# The Node server reads .env from the repo root. The Worker reads the same
# names from wrangler.jsonc "vars" and from secrets (wrangler secret put).

# --- Shared by the Node server and the Worker ---------------------------------

# development | test | production. Production requires SESSION_SECRET and
# switches the session cookie to Secure with the __Host- prefix.
APP_ENV=development

# Signs the anonymous session cookie (HMAC-SHA256). At least 32 characters.
# Generate one with: openssl rand -hex 32
# Left empty in development, a random secret is generated per process.
SESSION_SECRET=

# Comma-separated origins allowed to call the API with credentials, for when
# the web app is hosted on a different origin. Same-origin is always allowed.
# Example: https://drop-win.pages.dev,http://localhost:5300
ALLOWED_ORIGINS=

# SameSite attribute of the session cookie: Strict | Lax | None.
# None is only needed when the web app and API are on different sites, and
# forces Secure cookies.
COOKIE_SAMESITE=Strict

# --- Node server only ----------------------------------------------------------

# Port and interface for the API (and the built web app when WEB_DIST is set).
PORT=5301
HOST=127.0.0.1

# SQLite file, relative to apps/api when started through npm scripts.
# Use :memory: for a throwaway database.
DATABASE_PATH=data/drop-win.sqlite

# Set to true only behind a reverse proxy that overwrites X-Forwarded-For;
# otherwise clients could choose their own rate-limit key.
TRUST_PROXY=false

# Path to the built web app (apps/web/dist) to serve it from the same process.
# Relative paths resolve from apps/api. npm start sets this for you.
WEB_DIST=

# --- Web build (Vite) ----------------------------------------------------------

# Origin of the API when it is not served from the same origin as the web app.
# Leave empty for the default single-Worker deploy and for local development.
VITE_API_BASE=

# Where the house runs: server (the API above) or browser (a Web Worker in the
# page, with no server). npm run dev:browser and npm run build:pages always
# use browser, whatever this says.
VITE_BACKEND=server
