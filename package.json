{
  "name": "@drop-win/api",
  "version": "1.0.0",
  "private": "true",
  "description": "A provably fair, play-money ball-drop game with a commit-reveal RNG and an in-browser verifier.",
  "license": "MIT",
  "author": "Shashank Yadav",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "25.9.9",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "tables:check": "npm run tables:check -w @drop-win/fairness",
    "dev": "node scripts/dev.mjs",
    "dev:browser": "npm run dev:browser -w @drop-win/web",
    "build": "npm run build -w @drop-win/web && npm run build:worker -w @drop-win/api",
    "build:pages": "npm run build:pages -w @drop-win/web",
    "preview:pages": "npm run preview:pages -w @drop-win/web",
    "start": "npm run build -w @drop-win/web && WEB_DIST=../web/dist npm run start -w @drop-win/api",
    "e2e": "playwright test",
    "e2e:pages": "playwright test -c playwright.pages.config.ts"
  },
  "dependencies": {
    "@drop-win/contract": "1.0.0",
    "@drop-win/fairness": "1.0.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
